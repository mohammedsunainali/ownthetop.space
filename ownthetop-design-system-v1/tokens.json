{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "OwnTheTop Design System V1",
    "status": "v1",
    "figma": "https://www.figma.com/design/ye3qSatvvE02DXDr1pAr3d",
    "principle": "UI should be quiet. The 3D world should be loud."
  },
  "color": {
    "brand": {
      "navy": {"value":"#0D1B3D"},
      "blue": {"value":"#1677E8"},
      "sky": {"value":"#3FA9F5"},
      "lightBlue": {"value":"#8ACBFF"},
      "gold": {"value":"#FFC43D"},
      "teal": {"value":"#35C7A4"},
      "lavender": {"value":"#AFA2F5"},
      "peach": {"value":"#FFB084"},
      "coral": {"value":"#FF6B5A"}
    },
    "neutral": {
      "softWhite": {"value":"#F8FAFD"},
      "white": {"value":"#FFFFFF"},
      "cream": {"value":"#FFF9F0"},
      "dark": {"value":"#091326"},
      "muted": {"value":"#5B6680"},
      "mutedLight": {"value":"#A9B4C8"},
      "hairline": {"value":"#E7EBF2"},
      "borderStrong": {"value":"#CBD5E1"},
      "darkBorder": {"value":"#28405E"}
    },
    "semantic": {
      "success": {"value":"#22C55E"},
      "warning": {"value":"#F59E0B"},
      "error": {"value":"#EF4444"}
    },
    "role": {
      "surfaceCanvas": {"light":"{color.neutral.cream}","dark":"{color.neutral.dark}"},
      "surfaceCard": {"light":"{color.neutral.white}","dark":"{color.brand.navy}"},
      "surfaceSoft": {"light":"{color.neutral.softWhite}","dark":"{color.neutral.dark}"},
      "textPrimary": {"light":"{color.brand.navy}","dark":"{color.neutral.white}"},
      "textSecondary": {"light":"{color.neutral.muted}","dark":"{color.neutral.mutedLight}"},
      "borderDefault": {"light":"{color.neutral.hairline}","dark":"{color.neutral.darkBorder}"},
      "accentTop": "{color.brand.gold}",
      "accentWorld": "{color.brand.blue}",
      "accentRealtime": "{color.brand.teal}",
      "accentDiscovery": "{color.brand.lavender}",
      "accentCommunity": "{color.brand.peach}",
      "accentOutbid": "{color.brand.coral}"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Instrument Sans, Geist, sans-serif",
      "ui": "Geist, Inter, sans-serif",
      "mono": "Geist Mono, ui-monospace, monospace"
    },
    "displayXL": {"fontSize":72,"fontWeight":500,"lineHeight":1,"letterSpacing":-2.5},
    "displayLarge": {"fontSize":56,"fontWeight":500,"lineHeight":1.05,"letterSpacing":-2},
    "displayMedium": {"fontSize":40,"fontWeight":500,"lineHeight":1.1,"letterSpacing":-1},
    "displaySmall": {"fontSize":32,"fontWeight":500,"lineHeight":1.15,"letterSpacing":-0.5},
    "titleLarge": {"fontSize":24,"fontWeight":600,"lineHeight":1.3,"letterSpacing":-0.3},
    "titleMedium": {"fontSize":18,"fontWeight":600,"lineHeight":1.4,"letterSpacing":0},
    "titleSmall": {"fontSize":16,"fontWeight":600,"lineHeight":1.4,"letterSpacing":0},
    "body": {"fontSize":16,"fontWeight":400,"lineHeight":1.55,"letterSpacing":0},
    "bodySmall": {"fontSize":14,"fontWeight":400,"lineHeight":1.55,"letterSpacing":0},
    "caption": {"fontSize":13,"fontWeight":500,"lineHeight":1.4,"letterSpacing":0},
    "captionUppercase": {"fontSize":12,"fontWeight":600,"lineHeight":1.4,"letterSpacing":1.5},
    "button": {"fontSize":14,"fontWeight":600,"lineHeight":1,"letterSpacing":0},
    "navigation": {"fontSize":14,"fontWeight":500,"lineHeight":1.4,"letterSpacing":0},
    "metricPrice": {"fontFamily":"{typography.fontFamily.mono}","fontSize":24,"fontWeight":700,"lineHeight":1.15},
    "metricRank": {"fontFamily":"{typography.fontFamily.mono}","fontSize":32,"fontWeight":700,"lineHeight":1.05}
  },
  "spacing": {"1":4,"2":8,"3":12,"4":16,"5":20,"6":24,"8":32,"10":40,"12":48,"16":64,"20":80,"24":96,"32":128,"section":96},
  "radius": {"xs":6,"sm":8,"md":12,"lg":16,"xl":24,"2xl":32,"pill":9999},
  "shadow": {
    "subtle": "0 1px 2px rgba(13,27,61,.05)",
    "card": "0 6px 18px rgba(13,27,61,.07)",
    "floating": "0 14px 34px rgba(13,27,61,.10)",
    "modal": "0 24px 64px rgba(13,27,61,.16)"
  },
  "motion": {
    "fast": {"duration":80,"easing":"cubic-bezier(.2,.8,.2,1)"},
    "standard": {"duration":160,"easing":"cubic-bezier(.2,.8,.2,1)"},
    "emphasis": {"duration":240,"easing":"cubic-bezier(.16,1,.3,1)"},
    "world": {"duration":420,"easing":"cubic-bezier(.16,1,.3,1)"},
    "celebration": {"duration":720,"easing":"cubic-bezier(.22,1,.36,1)"}
  },
  "breakpoint": {"mobile":768,"tablet":1024,"desktop":1440},
  "zIndex": {"world":0,"worldLabels":10,"hud":20,"header":30,"drawer":40,"modal":50,"toast":60},
  "component": {
    "buttonHeight":44,
    "inputHeight":48,
    "touchTarget":44,
    "maxContentWidth":1280,
    "featureCardRadius":24,
    "heroArtworkRadius":32
  },
  "3d": {
    "floor": {"height":0.9,"depth":6,"width":12,"spacing":0.12},
    "tower": {"baseHeight":4,"setbackEvery":12,"glassOpacity":0.72},
    "camera": {"defaultDistance":34,"minDistance":14,"maxDistance":88},
    "environment": {"fogNear":45,"fogFar":160},
    "worldState": {
      "day": {"skyColor":"#83CBFF","waterColor":"#46B8EA","ambientLight":1.1,"directionalLight":2.6,"windowIntensity":0.1,"cloudBrightness":1,"aircraftLightIntensity":0.2,"signageBrightness":0.6,"mascotHighlight":1},
      "sunset": {"skyColor":"#F49A72","waterColor":"#C98787","ambientLight":0.75,"directionalLight":1.8,"windowIntensity":0.8,"cloudBrightness":0.86,"aircraftLightIntensity":0.8,"signageBrightness":1,"mascotHighlight":1.15},
      "night": {"skyColor":"#081529","waterColor":"#0F4266","ambientLight":0.22,"directionalLight":0.45,"windowIntensity":2.2,"cloudBrightness":0.35,"aircraftLightIntensity":1.8,"signageBrightness":1.6,"mascotHighlight":1.3}
    }
  }
}
